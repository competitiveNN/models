# RENDER_GID for accessing /dev/dri/renderD*. Get it with: getent group render | cut -d: -f3
RENDER_GID=989

# Where your models live (the safetensors folder). Mount is read-only inside the container.
MODELS_DIR=/var/home/fra/data/models/safetensors

# Optional: specify host GPU render nodes (if enumeration changes)
# GPU_RENDER_NODES=renderD128,renderD129
