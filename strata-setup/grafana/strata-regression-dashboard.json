{
  "dashboard": {
    "title": "Strata 2x B580 Regression & Performance",
    "uid": "strata-regression-perf",
    "tags": [
      "strata",
      "b580",
      "regression"
    ],
    "timezone": "browser",
    "refresh": "5m",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "Winner Decode (tok/s)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "strata_winner_decode_median",
            "legendFormat": "decode"
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Winner Prefill (tok/s)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "strata_winner_prefill_median",
            "legendFormat": "prefill"
          }
        ]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Baseline Decode (tok/s)",
        "gridPos": {
          "h": 4,
          "w": 6,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "strata_baseline_decode_median",
