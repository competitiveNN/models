          "h": 6,
          "w": 6,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "strata_winner_decode_ratio",
            "legendFormat": "ratio"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 2,
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.9
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        }
      },
      {
        "id": 6,
