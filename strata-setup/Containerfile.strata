# =============================================================================
# Strata SYCL Engine — Production Docker Image for 2× Intel Arc B580 (Battlemage)
# =============================================================================
# Base: Intel Deep Learning Essentials (Ubuntu 24.04, oneAPI 2025.3)
# Layers: oneAPI 2026.2 compiler/MKL/Level-Zero/UMF libs, source tree, Python deps
# Build:  docker build -f Containerfile.strata -t localhost/strata-old:latest .
# Run:    docker run -d --privileged --device /dev/dri --network host \
#           -v /path/to/models:/models:ro localhost/strata-old:latest
# =============================================================================

FROM docker.io/intel/deep-learning-essentials:2025.3.3-0-devel-ubuntu24.04 AS runtime

# --- Security & hygiene -------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# --- Runtime system packages (minimal) ---------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        libdrm2 \
        libze1 \
        libze-intel-gpu1 \
        intel-opencl-icd \
        libigc2 \
        ca-certificates \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# --- Copy oneAPI 2026.2 runtime libraries ------------------------------------
COPY oneapi-libs/compiler/2026.2/lib/ /opt/intel/oneapi/compiler/2026.2/lib/
COPY oneapi-libs/mkl/2026.2/lib/       /opt/intel/oneapi/mkl/2026.2/lib/
COPY oneapi-libs/redist/lib/           /opt/intel/oneapi/redist/lib/
COPY oneapi-libs/umf/1.2/lib/          /opt/intel/oneapi/umf/1.2/lib/

# --- Copy source tree (prebuilt engine + Python terminal app) ----------------
COPY strata-old-source /opt/strata

# --- Install engine component to expected location ---------------------------
RUN mkdir -p /root/.local/share/strata/components/engine && \
    cp -r /opt/strata/components/engine/* /root/.local/share/strata/components/engine/ 2>/dev/null || true

# --- Python dependencies -----------------------------------------------------
RUN pip install --break-system-packages --no-cache-dir --quiet \
        jinja2>=3.1 \
        regex>=2024.0 \
        fastapi>=0.110 \
        uvicorn[standard]>=0.29 \
        httpx>=0.27 \
        pydantic>=2.0 \
        pyyaml>=6.0 \
        psutil>=5.9 \
        requests>=2.31 \
        numpy>=1.24 \
        pillow>=10.0

# --- Environment -------------------------------------------------------------
# Verified 2xB580 serving profile (configs/strata-swift-iq3_xxs-2gpu-kernel-fused-max.json,
# run-strata-2gpu.sh --kernel-fused-max, runs/kernel-pipeline-verification.md).
# Baked into the production image so container launches do not drift from the audited
# winning configuration. Runtime tunables are still overridable per-run via --env=.
ENV ONEAPI_ROOT=/opt/intel/oneapi \
    LD_LIBRARY_PATH=/opt/intel/oneapi/compiler/2026.2/lib:/opt/intel/oneapi/mkl/2026.2/lib:/opt/intel/oneapi/redist/lib:/opt/intel/oneapi/umf/1.2/lib:${LD_LIBRARY_PATH} \
    SYCL_CACHE_PERSISTENT=1 \
    IGC_EnableGEPSimplification=0 \
    ZES_ENABLE_SYSMAN=1 \
    STRATA_VERIFY_DEVICE_PLAN=1 \
    STRATA_VERIFY_NO_HOST=0 \
    STRATA_WINDOW_SYNC=0 \
    STRATA_PREFILL_MMQ=1 \
    STRATA_RING_TIMEOUT_S=600 \
    STRATA_SPLIT_WAIT_MS=600000 \
    STRATA_VERIFY_DRAIN_TIMEOUT_MS=120000 \
    STRATA_SPIN_MAX=200000000 \
    STRATA_PREFILL_RING=1024 \
    STRATA_STAGER_RING=256 \
    STRATA_MIRROR_MIB=32768 \
    STRATA_DMA_BATCH=256 \
    STRATA_FETCH_THREADS=32 \
    STRATA_POOL_SPIN_US=100 \
    STRATA_PCIE_SPLIT_MODE=asymmetric \
    STRATA_MOE_DMA_OVERLAP=1 \
    STRATA_ASYNC_RING_BUFFER=1 \
    STRATA_PREFILL_STREAM_ALL=1 \
    STRATA_PREFILL_STREAM_MIN=1024 \
    STRATA_CHUNKED_FILL=1 \
    STRATA_KV_PREFETCH=1 \
    STRATA_IQ_PREFETCH=1 \
    STRATA_DISJOINT_ADAPT=1 \
    STRATA_PIPELINE_PRESTAGE=1 \
    STRATA_ADAPT_LAG=2 \
    STRATA_LOOKAHEAD=4 \
    STRATA_FILL_AHEAD=2 \
    STRATA_LEND_MIRROR=1 \
    STRATA_EXCHANGE_ROTATE=1 \
    STRATA_PREFILL_HELP=1 \
    STRATA_PREFILL_HELP_FRAC=0.3 \
    STRATA_PREFILL_LEND_PCT=50 \
    STRATA_PF_DMA_PAGEABLE=1 \
    STRATA_KV_STAGE_OWN=1 \
    STRATA_RING_BYTES=1 \
    STRATA_VERIFY_ALL_RESIDENT=0 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# --- Create non-root user for runtime security --------------------------------
RUN groupadd -r strata && useradd -r -g strata -d /opt/strata -s /bin/bash strata && \
    chown -R strata:strata /opt/strata /opt/intel/oneapi 2>/dev/null || true

# --- Working directory -------------------------------------------------------
WORKDIR /opt/strata

# --- Expose port -------------------------------------------------------------
EXPOSE 8080

# --- Health check ------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1

# --- Entrypoint (tini for proper signal handling) ----------------------------
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/strata/entrypoint.sh"]
CMD ["run"]
