#!/usr/bin/env bash
# Pre-commit hook: block secrets before they reach the working tree.
#
# Primary: gitleaks (if installed) scans staged content.
# Fallback: a regex scan of staged files so the hook still blocks locally
# when gitleaks is not on PATH.
#
# Usage:  .git/hooks/pre-commit   (symlinked or copied from hooks/pre-commit)
#
# To skip (e.g. when intentionally adding a placeholder): set
#   SKIP_SECRETS_SCAN=1  in the environment, or run `git commit --no-verify`.

set -u

SKIP="${SKIP_SECRETS_SCAN:-0}"
if [ "$SKIP" = "1" ]; then
  exit 0
fi

# Collect the list of staged files (added/modified, not deleted).
STAGED="$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)"
if [ -z "$STAGED" ]; then
  exit 0
fi

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

# Materialise staged blobs into a temp dir so scanners see the *new* content.
# Use -z (NUL-separated) so paths with spaces or multiple entries are split
# correctly — `printf '%s\0' "$STAGED"` would treat the whole multi-line
# string as a single (broken) path.
while IFS= read -r -d '' f; do
  mkdir -p "$TMPDIR/$(dirname "$f")"
  git show ":$f" > "$TMPDIR/$f" 2>/dev/null || true
done < <(git diff --cached -z --name-only --diff-filter=ACM 2>/dev/null)

# ── Primary: gitleaks ────────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks --no-banner --redact --exit-code 1 detect --source "$TMPDIR" >/dev/null 2>&1; then
    exit 0
  fi
  gitleaks --no-banner --redact detect --source "$TMPDIR"
  echo "⚠️  gitleaks found secrets in staged files. Remove them or set SKIP_SECRETS_SCAN=1 to bypass."
  exit 1
fi

# ── Fallback: regex scan ─────────────────────────────────────────────────────
# Covers common live-secret shapes. Adjust for your project's key types.
PAT='(nvapi-[A-Za-z0-9_-]{10,}|hf_[A-Za-z0-9]{10,}|sk-[A-Za-z0-9]{20,}|AIza[A-Za-z0-9_-]{10,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|cfat_[A-Za-z0-9_]{10,}|pypi-[A-Za-z0-9_.-]{20,}|sk-ant-[A-Za-z0-9_-]{20,})'

FOUND=0
while IFS= read -r -d '' f; do
  if grep -aInE "$PAT" "$f" >/dev/null 2>&1; then
    grep -aInE "$PAT" "$f"
    FOUND=1
  fi
done < <(find "$TMPDIR" -type f -print0)

if [ "$FOUND" = "1" ]; then
  echo "⚠️  Pre-commit hook: potential secrets detected in staged files."
  echo "   Install gitleaks for a stricter scan, or set SKIP_SECRETS_SCAN=1 to bypass."
  exit 1
fi

echo "✓ pre-commit: no secrets detected"

# ── Shellcheck (lint staged shell scripts) ─────────────────────────────────────
# Blocks unquoted variables / word-splitting / regex bugs in shell scripts.
# Skips silently when shellcheck is not installed (don't block contributors
# who haven't installed it — the secrets scan above is the hard gate).
if command -v shellcheck >/dev/null 2>&1; then
  SHLINT=0
  # Scan every staged script: *.sh files OR scripts whose first line is a
  # bash/sh shebang (agents-cli has no .sh extension, so the shebang check
  # is what catches it).
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    staged_file="$TMPDIR/$f"
    [ -f "$staged_file" ] || continue
    first="$(head -1 "$staged_file" 2>/dev/null || true)"
    case "$f" in
      *.sh) run_sc=1 ;;
      *) [[ "$first" =~ ^#!.*bash || "$first" =~ ^#!.*sh ]] && run_sc=1 || run_sc=0 ;;
    esac
    if [ "$run_sc" = "1" ]; then
      if ! shellcheck --severity=warning "$staged_file" >/dev/null 2>&1; then
        shellcheck --severity=warning "$staged_file"
        SHLINT=1
      fi
    fi
  done <<< "$STAGED"
  if [ "$SHLINT" = "1" ]; then
    echo "⚠️  Pre-commit hook: shellcheck found issues in staged shell scripts."
    echo "   Fix them or set SKIP_SECRETS_SCAN=1 to bypass."
    exit 1
  fi
  echo "✓ pre-commit: shellcheck clean"
fi

exit 0